<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <NoWarn>FS0075</NoWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- NuGet Package Metadata -->
    <PackageId>SageTUI</PackageId>
    <Version>0.9.9</Version>
    <Authors>Will Ehrendreich</Authors>
    <Copyright>Copyright © 2025 Will Ehrendreich</Copyright>
    <Description>F# terminal UI library. Elm Architecture (TEA/MVU), flexbox layout engine, 17+ widgets, SIMD-accelerated rendering, zero runtime dependencies.</Description>
    <PackageTags>fsharp;tui;terminal;elm-architecture;tea;mvu;functional;simd;layout;cli;widgets</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>0.9.8: Eliminate ghost echo on Unix raw input. Console.In.Read() causes the .NET runtime's StdInReader to echo each typed character to stdout itself (a managed write, independent of the termios ECHO flag), ghosting keystrokes onto the alternate screen in WSL2/terminals. The Unix input loop now reads via raw read(2) with incremental UTF-8 decoding, so typed characters never echo and multi-byte runes survive buffer boundaries. Windows path unchanged. 2,988 tests. 0.9.7: Fix bracketed-paste parsing so payloads enter paste mode at ESC[200~, preserve embedded escape fragments, and enforce a bounded transport limit. 0.9.5: Latest Harmony integration fixes — Cmd.withTimeout race hardening, Shift+Tab backtab handling, README test count refresh, and installer compatibility updates. 0.9.1: Sprint 71 additions — Sub.interval/intervalMs, Cmd.withTimeout, Program.withUpdateInterceptor, RemoteData.mapError, Deferred.viewString, ToastQueue.overlay. CI NETSDK1005 fix for multi-TFM restore. 2,764 tests. Previous: 0.9.0: Complete Elm Architecture (TEA/MVU) with 17+ widgets, SIMD-accelerated double-buffered rendering, flexbox layout engine, ErrorPolicy DU (CrashOnError|LogAndContinue|RecoverWith), TestHarness, Keys.bind, Cmd.fromAsync/fromTask, VirtualList multi-select, TextInput, FuzzyFinder, Viewport, Chart, Toast/ToastQueue, Tabs, Select, theme system, template package.</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/WillEhrendreich/SageTUI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/WillEhrendreich/SageTUI</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="9.0.303" />
  </ItemGroup>

  <ItemGroup>
    <Watch Include="**\*.fs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Color.fs" />
    <Compile Include="Buffer.fs" />
    <Compile Include="Layout.fs" />
    <Compile Include="BorderRender.fs" />
    <Compile Include="Element.fs" />
    <Compile Include="Measure.fs" />
    <Compile Include="CanvasRender.fs" />
    <Compile Include="Arena.fs" />
    <Compile Include="Effects.fs" />
    <Compile Include="Terminal.fs" />
    <Compile Include="Ansi.fs" />
    <Compile Include="Render.fs" />
    <Compile Include="ArenaRender.fs" />
    <Compile Include="Input.fs" />
    <Compile Include="Tea.fs" />
    <Compile Include="Navigation.fs" />
    <Compile Include="Detect.fs" />
    <Compile Include="Transition.fs" />
    <Compile Include="App.fs" />
    <Compile Include="Recording.fs" />
    <Compile Include="Widgets.fs" />
    <Compile Include="Scroll.fs" />
    <Compile Include="Testing.fs" />
  </ItemGroup>

</Project>
